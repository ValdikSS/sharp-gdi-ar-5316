// Include standard font and media definitions
#include <font.defs>
#include <media.defs>

// List the fonts that are supported, in this case all standard fonts...
Font *

// Manufacturer and driver version
Manufacturer "Sharp"
Version 1.0
Filter application/vnd.cups-raster 1 rastertosharpgdi

// Supported page sizes and their margins
HWMargins 0.1 0.1 0.1 0.1

MediaSize A3
*MediaSize A4
MediaSize A5
MediaSize B5
MediaSize EnvC5
MediaSize EnvDL
MediaSize EnvISOB5
MediaSize Letter
MediaSize Legal
MediaSize Executive
MediaSize Statement
MediaSize Env10

MediaType 0 Auto

// Only black-and-white output
*ColorModel Gray/Grayscale k chunky 0

// Supported resolutions
*Resolution k 1 0 0 0 "600dpi/600 DPI"

// Supported input slots
*InputSlot 7 "Auto/Automatic Selection"
InputSlot 261 "Manual/Manual Feed"
InputSlot 257 "Cassette/Tray 1"

{
  Throughput 16
  ModelName "AR-5316"
  PCFileName "sh5316.ppd"
}

{
  Throughput 16
  ModelName "AR-5320"
  PCFileName "sh5320.ppd"
}
